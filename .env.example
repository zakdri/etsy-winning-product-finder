# Rotate the credentials that appeared in the screenshot before using this file.
# Never commit a real .env file.
ETSY_API_KEY=your_rotated_keystring
ETSY_SHARED_SECRET=your_rotated_shared_secret
# Optional. Keep blank unless you completed Etsy OAuth authorization.
# OAuth may not override marketplace pagination restrictions tied to app Access Level.
ETSY_ACCESS_TOKEN=
ETSY_API_BASE_URL=https://openapi.etsy.com/v3/application
ETSY_TIMEOUT_SECONDS=30
ETSY_USER_AGENT=seller-trend-product-research/0.1
